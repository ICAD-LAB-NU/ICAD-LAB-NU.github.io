---
import {SITE} from '../config/site';
const base=import.meta.env.BASE_URL;
const links=[['Research','research/'],['People','people/'],['Publications','publications/'],['Projects','projects/'],['News','news/'],['Contact','contact/']];
const path=Astro.url.pathname;
---
<a class="skip" href="#main">Skip to content</a>
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={base} aria-label="ICAD homepage">
      <span class="brand-glyph" aria-hidden="true">
        <img src={`${base}favicon.svg`} alt="" class="brand-logo-img" />
      </span>
      <span class="brand-copy">
        <strong>ICAD</strong>
        <small>INTELLIGENT CONTROL & APPLIED DYNAMICS Lab</small>
      </span>
    </a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Toggle navigation"><span></span><span></span><span></span></button>
    <nav id="site-nav" class="site-nav" aria-label="Main navigation">
      {links.map(([label,href])=><a class:list={{active:path.includes('/'+href)}} href={base+href}>{label}</a>)}
    </nav>
  </div>
</header>
<script>
  const button=document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav=document.querySelector<HTMLElement>('#site-nav');
  button?.addEventListener('click',()=>{
    const open=button.getAttribute('aria-expanded')!=='true';
    button.setAttribute('aria-expanded',String(open));
    nav?.classList.toggle('is-open',open);
  });
  nav?.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{nav.classList.remove('is-open');button?.setAttribute('aria-expanded','false')}));
</script>

<style>
  /* Larger, highlighted logo */
  :global(header.site-header){height:112px}
  .brand{gap:16px}
  @media (min-width: 821px) { :global(nav.site-nav a){padding:44px 0} }
  .brand-glyph {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 84px;
    height: 84px;
    flex-shrink: 0;
    background: #fff;
    border-radius: 50%;
    padding: 3px;
    box-shadow: 0 0 0 2px #344C98, 0 6px 18px rgba(23, 56, 110, .22);
    transition: transform .2s ease, box-shadow .2s ease;
  }
  .brand:hover .brand-glyph {
    transform: scale(1.06);
    box-shadow: 0 0 0 2px #344C98, 0 10px 26px rgba(23, 56, 110, .32);
  }
  .brand-logo-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    border-radius: 50%;
  }
  .brand-copy strong { font-size: 30px; }
  .brand-copy small { font-size: 10px; }
  @media (max-width: 820px) {
    :global(header.site-header){height:88px}
    :global(nav.site-nav){top:88px}
    .brand-glyph { width: 66px; height: 66px; }
    .brand-copy strong { font-size: 24px; }
  }
  @media (max-width: 550px) {
    .brand-glyph { width: 58px; height: 58px; }
    .brand-copy strong { font-size: 21px; }
    .brand-copy small { font-size: 7px; }
  }
</style>
